# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file or share your bot token.
# If a token is ever exposed, reset it immediately in the Discord Developer Portal.

# Bot token (Developer Portal > your application > Bot)
TOKEN=

# Application ID (Developer Portal > General Information)
CLIENT_ID=

# ID of your Discord server (Discord > Settings > Advanced > Developer Mode,
# then right-click the server > Copy Server ID)
GUILD_ID=

# Role IDs (right-click a role > Copy Role ID). Used from v2.0.0 onwards.
OWNER_ROLE_ID=
MANAGERS_ROLE_ID=
TEAM_ROLE_ID=
