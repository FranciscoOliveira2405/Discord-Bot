{
  "name": "team-bot",
  "version": "2.0.0",
  "description": "Discord bot for team management: schedule, roster, absences, timezones, announcements and moderation",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "deploy": "node deploy-commands.js",
    "check": "node scripts/check-commands.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,yml,yaml}\"",
    "test": "node --test",
    "verify": "npm run lint && npm run format:check && npm test && npm run check"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discordjs",
    "team-management",
    "sqlite"
  ],
  "author": "Francisco Oliveira",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranciscoOliveira2405/Discord-Bot.git"
  },
  "bugs": {
    "url": "https://github.com/FranciscoOliveira2405/Discord-Bot/issues"
  },
  "homepage": "https://github.com/FranciscoOliveira2405/Discord-Bot#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
